// Test file for Ruchy v1.5.0 features
fun fibonacci(n: i32) -> i32 {
    if n <= 1 {
        return n
    }
    fibonacci(n - 1) + fibonacci(n - 2)
}

class Calculator {
    value: f64
    
    fun new(initial: f64) -> Calculator {
        Calculator { value: initial }
    }
    
    fun add(self, x: f64) -> f64 {
        self.value + x
    }
    
    fun multiply(self, x: f64) -> f64 {
        self.value * x
    }
}

actor Counter {
    count: i32
    
    receive increment() {
        self.count = self.count + 1
    }
    
    receive get() -> i32 {
        self.count
    }
}

fun main() {
    let result = fibonacci(10)
    println(f"Fibonacci(10) = {result}")
    
    let calc = Calculator::new(5.0)
    let sum = calc.add(3.0)
    println(f"5 + 3 = {sum}")
    
    // Test pattern matching
    match result {
        0 => println("Zero"),
        1..10 => println("Small number"),
        _ => println("Large number")
    }
    
    // Test pipeline operator
    let numbers = [1, 2, 3, 4, 5]
    let doubled = numbers 
        |> map(|x| x * 2)
        |> filter(|x| x > 4)
        |> collect()
    
    // Test async/await
    async fun fetch_data() -> String {
        await some_async_operation()
        "Data fetched"
    }
    
    // Test error handling
    fun divide(a: f64, b: f64) -> Result<f64, String> {
        if b == 0.0 {
            Err("Division by zero")
        } else {
            Ok(a / b)
        }
    }
    
    let result = divide(10.0, 2.0)?
    println(f"10 / 2 = {result}")
}